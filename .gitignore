__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# 凭据：绝不入库（仓库是 public）
*aikey*
*.token
*.key
*.pem
.env
.env.*
!src/ai_backends.yaml
# 本地探针产物（.probe/ 与 .tools/ 都是临时内核/日志，不入库）
.probe/
.probe_eval/
.probe_eval_stage/
.league_work/
.league_stage/
.tools/


# 探针日志与本地诊断产物
logs/
ci_capability_result.json

# 稳定性档案损坏时 load() 的改名留证（*.corrupt-<时间戳>）。
# 它是本地诊断产物，绝不能被 local_probe 的 `git add -A state` 顺手提交上去。
state/*.corrupt-*

# 历史库隔离源的 staging（含节点凭据；local_probe 会 `git add -A state`）。
# 由 src/local_probe.py 的 stage_archive_nodes() 每轮重建，绝不能入库。
state/archive_nodes/


# 云效 Codeup 的 HTTPS 克隆密码（明文，绝不入库）
*.https
